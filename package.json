{
  "name": "system-monitor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --mode dev",
    "build:github": "vite build --mode github",
    "build:rainmeter": "vite build --mode rainmeter",
    "build:electron": "vite build --mode electron",
    "electron:dev": "electron electron/main.cjs",
    "electron:build": "npm run build:electron && electron-builder",
    "electron:preview": "npm run build:electron && electron electron/main.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "predeploy": "npm run build:github",
    "deploy": "gh-pages -d dist"
  },
  "build": {
    "appId": "com.felix.system-monitor",
    "productName": "System Monitor",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../system-monitor-api-v2/bin/Release/net10.0/win-x64/publish",
        "to": "api",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "System-Monitor-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "date-fns": "^4.3.0",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "gh-pages": "^6.3.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
